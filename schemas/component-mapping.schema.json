{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://caresmartz360.com/design-system/component-mapping.schema.json",
  "title": "CareSmartz360 portal component mapping",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "portal",
    "figmaFileKey",
    "components"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "portal": {
      "type": "string",
      "minLength": 1
    },
    "figmaFileKey": {
      "type": "string",
      "minLength": 1
    },
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "componentKey",
          "nodeId",
          "maturity",
          "semanticDependencies",
          "contractPath",
          "jiraIssue",
          "snapshotRef"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "componentKey": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[a-f0-9]{40}$"
              },
              {
                "type": "null"
              }
            ],
            "$comment": "null is permitted ONLY while componentKeyStatus documents the pending enumeration (COMPONENT-MAPPING-CONTRACT amendment, 2026-09-10)"
          },
          "nodeId": {
            "type": "string",
            "pattern": "^[0-9]+:[0-9]+$"
          },
          "maturity": {
            "enum": [
              "discovered",
              "draft",
              "reviewed",
              "pilot",
              "stable",
              "deprecated"
            ]
          },
          "semanticDependencies": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "contractPath": {
            "type": "string",
            "minLength": 1
          },
          "jiraIssue": {
            "type": "string",
            "pattern": "^C360-[0-9]+$"
          },
          "snapshotRef": {
            "type": "string",
            "minLength": 1
          },
          "componentKeyStatus": {
            "type": "string",
            "minLength": 1
          },
          "nodeIdNote": {
            "type": "string"
          },
          "atomNodeIds": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "pattern": "^[0-9]+:[0-9]+$"
            }
          },
          "componentKeys": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "pattern": "^[a-f0-9]{40}$"
            }
          },
          "componentKeyNote": {
            "type": "string"
          },
          "atomComponentKeys": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "pattern": "^[a-f0-9]{40}$"
            }
          },
          "type": {
            "$comment": "Figma node kind for this row (Figma-AI enhanced mapping, 2026-09-21).",
            "enum": [
              "SECTION",
              "COMPONENT_SET",
              "COMPONENT"
            ]
          },
          "figmaName": {
            "$comment": "Verbatim Figma layer name (may differ from this row's human name).",
            "type": "string",
            "minLength": 1
          },
          "pageId": {
            "$comment": "Figma page node this component lives on.",
            "type": "string",
            "pattern": "^[0-9]+:[0-9]+$"
          },
          "pageName": {
            "type": "string",
            "minLength": 1
          },
          "figmaUrl": {
            "$comment": "Deep link to this row's nodeId; derived from figmaFileKey + nodeId.",
            "type": "string",
            "pattern": "^https://www\\.figma\\.com/design/"
          }
        },
        "if": {
          "properties": {
            "componentKey": {
              "type": "null"
            }
          }
        },
        "then": {
          "required": [
            "componentKeyStatus"
          ]
        }
      }
    },
    "$note": {
      "type": "string"
    },
    "$meta": {
      "$comment": "File-level provenance + Figma page index (Figma-AI enhanced mapping, 2026-09-21).",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "fileKey": { "type": "string", "minLength": 1 },
        "lastEnriched": { "type": "string" },
        "source": { "type": "string" },
        "pages": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "pageId": { "type": "string", "pattern": "^[0-9]+:[0-9]+$" },
              "pageName": { "type": "string", "minLength": 1 },
              "componentCount": { "type": "integer", "minimum": 0 }
            },
            "required": ["pageId", "pageName"]
          }
        }
      }
    }
  }
}
