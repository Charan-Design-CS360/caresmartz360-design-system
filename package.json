{
  "name": "@caresmartz360/design-system",
  "version": "0.0.0-development",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "validate": "npm run validate:portal-manifests && npm run validate:portal-isolation && npm run validate:figma-snapshots && npm test",
    "validate:figma-snapshots": "node scripts/validate-figma-snapshots.mjs",
    "validate:portal-manifests": "node scripts/validate-portal-manifests.mjs",
    "validate:portal-isolation": "node scripts/validate-portal-isolation.mjs",
    "release:check": "DS_REQUIRE_FRESH_SNAPSHOTS=true npm run validate"
  },
  "engines": {
    "node": ">=20"
  }
}
